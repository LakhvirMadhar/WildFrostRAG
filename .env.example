# WildFrostRAG Environment Variables

# OpenAI API Key for LLM interactions
OPENAI_API_KEY=''

# Neo4j Database Credentials
NEO4J_USERNAME=''
NEO4J_PASSWORD=''
NEO4J_URI=''

# Optional: Configuration for different models/settings
EMBEDDING_MODEL_NAME=''
OPENAI_MODEL_NAME=''
# Dagster instance storage (run history). Absolute path to an existing folder;
# without it, every dagster command creates a throwaway .tmp_dagster_home_* folder here.
DAGSTER_HOME=/absolute/path/to/WildFrostRAG/.dagster_home
